# LLM proxy environment. Docker Compose automatically reads .env from this
# directory and substitutes the values into docker-compose.yaml.
# Copy this file to .env and edit: cp .env.example .env

# Address (host:port) of the LLM backend (e.g. vLLM) that the proxy forwards
# to. Use an IP such as 192.168.1.3:1025, or host.docker.internal if the
# backend runs on the Docker host itself.
LLM_BACKEND=host.docker.internal:21025

# Port the proxy listens on. Only used by the Python rewrite (python/);
# the OpenResty service hardcodes 9999. Run parallel tests on another port
# (e.g. 9998) so the live proxy is never disturbed.
PORT=9999

# top_p forced onto rewritten request bodies (/v1/completions and
# /v1/chat/completions). A negative value (the default) leaves the client's
# top_p untouched.
TOP_P=-1

# GPU temperature checks (cool-down guard). Only "1" or "true"
# (case-insensitive) enables them; anything else (or an unset value)
# disables the checks and every other TEMP_CHECK_* variable is ignored.
TEMP_CHECK_ENABLED=0
# Full URL of the monitor returning a JSON object of GPU temperatures,
# e.g. {"gpu_0":48,"gpu_1":49,...}
TEMP_CHECK_ENDPOINT=http://host.docker.internal:18082/temperatures
# Stall requests while any GPU temperature is above this value...
TEMP_CHECK_STALL_ABOVE=74
# ...and resume once every temperature is below this value (hysteresis).
TEMP_CHECK_RESUME_BELOW=60
# When the monitor endpoint is unreachable: 1/true = forward the request
# as if the temperatures were OK (fail open); 0 (default) = keep the
# conservative stall until the monitor is reachable again. The dashboard
# also has a runtime toggle that turns the whole guard off without a
# restart (resets to on at proxy restart).
TEMP_CHECK_FAIL_OPEN=0
# Seconds between monitor polls (shared across all requests/workers).
TEMP_CHECK_POLL_INTERVAL=1.0
# Seconds a fetched temperature snapshot stays valid in the shared cache.
TEMP_CHECK_CACHE_TTL=0.9
# Millisecond timeout for monitor HTTP calls.
TEMP_CHECK_HTTP_TIMEOUT=5000
# Path (inside the container) where stall records are written.
TEMP_CHECK_STALL_LOG=/var/log/nginx/completions/stall.log

# Keep-alive heartbeat for streaming clients: the SSE handshake and the first
# heartbeat are sent KEEPALIVE_DELAY seconds after the request was received,
# then a heartbeat every KEEPALIVE_INTERVAL seconds while the upstream is
# still generating.
KEEPALIVE_DELAY=30
KEEPALIVE_INTERVAL=5

# Upstream exchange deadline / resend: each attempt to the backend (connect +
# send + full non-streaming response) must finish within UPSTREAM_TIMEOUT
# seconds; when it does not, the connection to the backend is dropped and the
# identical request is resent, up to UPSTREAM_RETRIES times after the first
# failure (UPSTREAM_RETRIES=1 -> one retry attempt, two sends in total).
# Both values are required: the proxy disables itself if either is missing.
UPSTREAM_TIMEOUT=600
UPSTREAM_RETRIES=1

# Tool-name guard for antml markup tool calls: remap (default) / strip / off.
# TOOL_NAME_RETRY=1 resends the identical request once when a hallucinated
# name would be stripped; set to 0 to disable that silent retry.
TOOL_NAME_GUARD=remap
TOOL_NAME_RETRY=1
