upstream llm_backend {
    server ${LLM_BACKEND};
    keepalive 16;
}

server {
    listen 9999;

    # Large enough for long LLM prompts and (non-streamed) completions.
    client_max_body_size 100m;
    client_body_buffer_size 100m;
    subrequest_output_buffer_size 32m;

    # /v1/completions and /v1/chat/completions: rewrite the JSON request body
    # (top_p=0.95, stream=false) and forward it to the same backend path.
    location ~ ^/v1/(chat/)?completions$ {
        js_content completions.completions;
    }

    # Internal location used by the njs subrequest to send the modified body
    # to the backend at the original path (e.g. /v1/chat/completions).
    location ~ ^/_completions/(.+)$ {
        internal;
        rewrite ^/_completions/(.+)$ /$1 break;
        proxy_pass http://llm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host ${LLM_BACKEND};
        proxy_set_header Content-Type application/json;
        proxy_set_header Accept-Encoding "";
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Everything else: transparent proxy to the same backend.
    location / {
        proxy_pass http://llm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host ${LLM_BACKEND};
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
