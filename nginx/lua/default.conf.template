server {
    listen 9999;

    # Required: arms the client read event so ngx.on_abort fires when the
    # client disconnects while the upstream call is in flight.
    lua_check_client_abort on;

    # Large enough for long LLM prompts and (non-streamed) completions.
    client_max_body_size 100m;
    client_body_buffer_size 100m;

    # Backend address used by the Lua cosocket handler.
    set $llm_backend ${LLM_BACKEND};

    # top_p forced onto rewritten request bodies; a negative value (the
    # default) leaves the client's top_p untouched.
    set $top_p ${TOP_P};

    # GPU temperature monitor (cool-down guard). TEMP_CHECK_ENABLED ("1" or
    # "true", case-insensitive) arms it; when unset or any other value the
    # monitor is disabled, the TEMP_CHECK_* values below are ignored
    # (substituted as empty strings at startup) and the proxy behaves as if
    # every check passed. Endpoint is a full URL, read by the Lua handler
    # via ngx.var.
    set $temp_check_enabled ${TEMP_CHECK_ENABLED};
    set $temp_check_endpoint ${TEMP_CHECK_ENDPOINT};
    set $temp_check_stall_above ${TEMP_CHECK_STALL_ABOVE};
    set $temp_check_resume_below ${TEMP_CHECK_RESUME_BELOW};
    set $temp_check_poll_interval ${TEMP_CHECK_POLL_INTERVAL};
    set $temp_check_cache_ttl ${TEMP_CHECK_CACHE_TTL};
    set $temp_check_http_timeout ${TEMP_CHECK_HTTP_TIMEOUT};
    set $temp_check_stall_log ${TEMP_CHECK_STALL_LOG};

    # Keep-alive heartbeat for streaming clients: fake empty SSE chunks start
    # KEEPALIVE_DELAY seconds after the request was received and repeat every
    # KEEPALIVE_INTERVAL seconds until the upstream response arrives, so
    # clients with first-byte timeouts don't abort the stream.
    set $keepalive_delay ${KEEPALIVE_DELAY};
    set $keepalive_interval ${KEEPALIVE_INTERVAL};
    set $tool_name_guard ${TOOL_NAME_GUARD};
    set $tool_name_retry ${TOOL_NAME_RETRY};

    # /v1/completions and /v1/chat/completions: rewrite the JSON request body
    # (stream=false, top_p forced to TOP_P when non-negative) and forward it
    # to the backend, converting the
    # non-streaming response into SSE when the client requested streaming. The
    # upstream connection is closed as soon as the client disconnects.
    location ~ ^/v1/(chat/)?completions$ {
        access_by_lua_block {
            ngx.req.read_body()
        }
        content_by_lua_block {
            require("completions").completions()
        }
        log_by_lua_block {
            require("completions").log_request()
        }
    }

    # Everything else: transparent proxy to the same backend.
    location / {
        proxy_pass http://${LLM_BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host ${LLM_BACKEND};
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }
}
