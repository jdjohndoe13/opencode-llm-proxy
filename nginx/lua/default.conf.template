server {
    listen 9999;

    # Required: arms the client read event so ngx.on_abort fires when the
    # client disconnects while the upstream call is in flight.
    lua_check_client_abort on;

    # Large enough for long LLM prompts and (non-streamed) completions.
    client_max_body_size 100m;
    client_body_buffer_size 100m;

    # Backend address used by the Lua cosocket handler.
    set $llm_backend ${LLM_BACKEND};

    # GPU temperature monitor endpoint (full URL, substituted from
    # TEMP_ENDPOINT at startup, read by the Lua handler via ngx.var).
    set $temp_endpoint ${TEMP_ENDPOINT};

    # GPU temperature monitor tuning. Every value is injected from the
    # environment at startup (no defaults: the container refuses to start
    # when a variable is missing).
    set $stall_above ${STALL_ABOVE};
    set $resume_below ${RESUME_BELOW};
    set $temp_poll_interval ${TEMP_POLL_INTERVAL};
    set $temp_cache_ttl ${TEMP_CACHE_TTL};
    set $temp_http_timeout ${TEMP_HTTP_TIMEOUT};
    set $stall_log ${STALL_LOG};

    # Keep-alive heartbeat for streaming clients: fake empty SSE chunks start
    # KEEPALIVE_DELAY seconds after the request was received and repeat every
    # KEEPALIVE_INTERVAL seconds until the upstream response arrives, so
    # clients with first-byte timeouts don't abort the stream.
    set $keepalive_delay ${KEEPALIVE_DELAY};
    set $keepalive_interval ${KEEPALIVE_INTERVAL};

    # /v1/completions and /v1/chat/completions: rewrite the JSON request body
    # (top_p=0.95, stream=false) and forward it to the backend, converting the
    # non-streaming response into SSE when the client requested streaming. The
    # upstream connection is closed as soon as the client disconnects.
    location ~ ^/v1/(chat/)?completions$ {
        access_by_lua_block {
            ngx.req.read_body()
        }
        content_by_lua_block {
            require("completions").completions()
        }
        log_by_lua_block {
            require("completions").log_request()
        }
    }

    # Everything else: transparent proxy to the same backend.
    location / {
        proxy_pass http://${LLM_BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host ${LLM_BACKEND};
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }
}
